# APP_URL : adresse où l'app web est hébergée (liens, retours de connexion, API).
APP_URL="MY_APP_URL"

# CORS_ORIGINS: origines supplémentaires autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGINS=""

# VITE_MAPTILER_KEY: clé MapTiler pour le fond de carte (optionnelle)
VITE_MAPTILER_KEY=""

# Supabase : URL du projet + clé publique anon (jamais la clé service_role)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Notifications push : passer à true une fois google-services.json (Android) / clé APNs (iPhone) ajoutés
VITE_PUSH_ENABLED=false
