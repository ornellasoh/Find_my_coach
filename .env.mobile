VITE_SUPABASE_ANON_KEY=sb_publishable_uXt961YBusOX-76YAoKPVQ_3iSSw6HD
VITE_PUSH_ENABLED=true

# Lien public des coachs (bio Instagram)
VITE_PUBLIC_PROFILE_URL=https://findmycoach.io/coach/

# Bouton « Continuer avec Apple » (fournisseur Apple activé dans Supabase le 13 oct. 2026)
VITE_APPLE_SIGNIN=true
